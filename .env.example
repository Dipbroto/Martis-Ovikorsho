# Supabase (auth, saved missions, chat history). Without these the app runs in offline/standalone mode.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Gemini key for LOCAL DEVELOPMENT ONLY (read by `vite dev`, stripped from production builds).
# In production the key lives in the Supabase Edge Function secrets instead - see README.
VITE_GEMINI_API_KEY=

# NASA API Portal key (api.nasa.gov) for DONKI space weather and NASA Open APIs (1,000 req/hr).
# Get a free key at https://api.nasa.gov
VITE_NASA_API_KEY=

